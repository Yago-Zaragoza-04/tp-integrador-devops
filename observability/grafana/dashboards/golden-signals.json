      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(http_requests_total{service=\"tp-integrador-devops\", route!=\"/metrics\", status_code=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "4xx (cliente)",
          "refId": "A",
          "range": true,
